* text=auto
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
/LICENSE text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
# Preserve the exact upstream skill snapshots, including their licenses.
/.agents/skills/elevenlabs-sound-effects/** -text
/.agents/skills/elevenlabs-music/** -text
/third-party/*.txt text eol=lf
# Preserve upstream COPYING bytes, including its original trailing whitespace.
/third-party/LGPL-2.1-mpg123.txt -text whitespace=-blank-at-eol

*.cpp text eol=lf
*.nsh text eol=lf
/native/CMakeLists.txt text eol=lf
/third-party/encoding/*-LICENSE.txt -text whitespace=-blank-at-eol
/third-party/node-LICENSE.txt -text whitespace=-blank-at-eol,-space-before-tab

/third-party/encoding/*-checksums.txt -text
# Preserve the vendored FluidSynth/gcem license bytes and the bundled bank archive exactly.
/third-party/synthesis/*-LICENSE.txt -text whitespace=-blank-at-eol
/third-party/synthesis/*.tar.gz -text
/third-party/synthesis/*.zip -text
/resources/soundfonts/*-LICENSE.txt -text whitespace=-blank-at-eol
/resources/soundfonts/*.sf2 -text
*.svg text eol=lf
